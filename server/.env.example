# PRIVATE server secrets — configure on the server; never copy these to Angular/public/.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_IN_YOUR_SECRET_MANAGER
KORA_EVENT_SLUGS=event-1
ALLOWED_ORIGINS=https://YOUR-APP.example
PORT=8787
# Install ffmpeg and ffprobe in the server runtime.
# Give trusted operator accounts app_metadata.kora_wall_operator=true via admin only.
